---
import SocialIcons from "../../commons/socialIcons/socialIcons.jsx";
import Typewriter from "./typewriter.jsx";
---

<header class="mx-auto max-w-5xl px-6 pt-36 pb-24 md:pt-48 md:pb-32">
  <p class="font-mono text-sm text-muted">Athlone, Ireland</p>

  <h1
    class="mt-4 text-4xl font-semibold tracking-tight text-fg md:text-6xl"
  >
    Charlie Gallagher
  </h1>

  <Typewriter client:load />

  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">
    I build AI agents and the cloud tools around them at Hewlett Packard
    Enterprise, and I'm in my final year of Software Design with AI for Cloud
    Computing at TUS.
  </p>

  <ul class="mt-6 space-y-2 text-sm text-fg">
    <li class="flex items-center gap-2">
      <span class="h-2 w-2 shrink-0 rounded-full bg-primary" aria-hidden="true"
      ></span>
      Joining HPE full-time as an Innovation Engineer (AI &amp; Cloud) in June
      2027
    </li>
    <li class="flex items-center gap-2">
      <img src="/svg/aws.svg" alt="" width="16" height="16" class="h-4 w-4 shrink-0" />
      <a
        href="https://www.credly.com/badges/8222cd26-aa4e-456f-85d1-f045cba5fac5/public_url"
        target="_blank"
        rel="noopener noreferrer"
        class="underline decoration-line underline-offset-4 transition-colors hover:decoration-primary"
      >
        AWS Certified AI Practitioner
      </a>
    </li>
  </ul>

  <div class="mt-10 flex flex-wrap items-center gap-4">
    <a
      href="/projects"
      class="rounded-md bg-fg px-5 py-2.5 text-sm font-medium text-canvas transition-colors hover:bg-white"
    >
      View projects
    </a>
    <a
      href="/contact"
      class="rounded-md border border-line px-5 py-2.5 text-sm font-medium text-fg transition-colors hover:border-muted"
    >
      Get in touch
    </a>
    <div class="ml-2">
      <SocialIcons />
    </div>
  </div>
</header>
