---
const stack = [
  { name: "Python", icon: "python" },
  { name: "TypeScript", icon: "typescript" },
  { name: "Go", icon: "go" },
  { name: "React", icon: "react" },
  { name: "FastAPI", icon: "fastapi" },
  { name: "Kubernetes", icon: "kubernetes" },
  { name: "Docker", icon: "docker" },
  { name: "AWS", img: "/svg/aws.svg" },
  { name: "Azure", icon: "azure" },
  { name: "PostgreSQL", icon: "postgresql" },
  { name: "PyTorch", icon: "pytorch" },
  { name: "GitHub Actions", icon: "githubactions" },
  { name: "Java", icon: "java" },
  { name: "Linux", icon: "linux" },
];

// Two copies so the strip loops by sliding exactly half its width
const loop = [...stack, ...stack];
---

<section
  aria-label="Technologies I work with"
  class="slider-mask overflow-hidden border-y border-line py-8"
>
  <ul class="animate-scroll flex w-max gap-16 hover:[animation-play-state:paused]">
    {
      loop.map((tech, i) => (
        <li
          class="group flex items-center gap-3"
          aria-hidden={i >= stack.length ? "true" : undefined}
        >
          <img
            src={
              tech.img ||
              `https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${tech.icon}/${tech.icon}-original.svg`
            }
            alt=""
            class="h-8 w-8 object-contain transition-transform group-hover:scale-110"
            width="32"
            height="32"
            loading="lazy"
          />
          <span class="text-lg text-fg">
            {tech.name}
          </span>
        </li>
      ))
    }
  </ul>
</section>

<style is:global>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .animate-scroll {
    animation: scroll 60s linear infinite;
  }

  .slider-mask {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-scroll {
      animation: none;
    }
  }
</style>
