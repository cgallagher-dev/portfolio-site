---
import ProjectCard from "../../project/projectCard.astro";
import { projects } from "../../../data/projectData.js";

const featured = projects.filter((p) => p.featured);
---

<section id="work" class="mx-auto max-w-5xl px-6 py-20">
  <p class="font-mono text-sm text-primary">Selected work</p>
  <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
    <h2 class="text-3xl font-semibold tracking-tight text-fg">
      What I've been building
    </h2>
    <a href="/projects" class="text-sm text-muted transition-colors hover:text-fg">
      All projects &rarr;
    </a>
  </div>

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {featured.map((p) => <ProjectCard {...p} />)}
  </div>
</section>
