---
import { recognition } from "../../../data/recognitionData";
---

<section id="recognition" class="mx-auto max-w-5xl px-6 py-20">
  <p class="font-mono text-sm text-primary">Recognition</p>
  <h2 class="mt-2 text-3xl font-semibold tracking-tight text-fg">
    Awards, certifications and talks
  </h2>

  <ul class="mt-10 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
    {
      recognition.map((item) => (
        <li class="bg-canvas p-6">
          <h3 class="font-medium text-fg">
            {item.href ? (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-line underline-offset-4 transition-colors hover:decoration-primary"
              >
                {item.title}
              </a>
            ) : (
              item.title
            )}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{item.detail}</p>
        </li>
      ))
    }
  </ul>
</section>
