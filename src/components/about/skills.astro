---
import { SiHuggingface, SiLangchain, SiOllama, SiPydantic } from "react-icons/si";

const devicon = (name: string) =>
  `https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${name}/${name}-original.svg`;

const groups = [
  {
    name: "Languages",
    items: [
      { name: "Python", img: devicon("python") },
      { name: "TypeScript", img: devicon("typescript") },
      { name: "Go", img: devicon("go") },
      { name: "Java", img: devicon("java") },
      { name: "JavaScript", img: devicon("javascript") },
      { name: "Bash", img: devicon("bash") },
    ],
  },
  {
    name: "AI and data",
    items: [
      { name: "PyTorch", img: devicon("pytorch") },
      { name: "TensorFlow", img: devicon("tensorflow") },
      { name: "scikit-learn", img: devicon("scikitlearn") },
      { name: "Pandas", img: devicon("pandas") },
      { name: "LangChain", Icon: SiLangchain },
      { name: "Ollama", Icon: SiOllama },
      { name: "Hugging Face", Icon: SiHuggingface },
    ],
  },
  {
    name: "Apps and APIs",
    items: [
      { name: "React", img: devicon("react") },
      { name: "FastAPI", img: devicon("fastapi") },
      { name: "Pydantic", Icon: SiPydantic },
      { name: "Flutter", img: devicon("flutter") },
      { name: "Figma", img: devicon("figma") },
    ],
  },
  {
    name: "Cloud and DevOps",
    items: [
      { name: "Kubernetes", img: devicon("kubernetes") },
      { name: "Docker", img: devicon("docker") },
      { name: "AWS", img: "/svg/aws.svg" },
      { name: "Azure", img: devicon("azure") },
      { name: "PostgreSQL", img: devicon("postgresql") },
      { name: "Linux", img: devicon("linux") },
      { name: "GitHub Actions", img: devicon("githubactions") },
      { name: "Jenkins", img: devicon("jenkins") },
      { name: "Git", img: devicon("git") },
    ],
  },
];
---

<section id="skills" class="mx-auto max-w-5xl px-6 py-20">
  <p class="font-mono text-sm text-primary">Skills</p>
  <h2 class="mt-2 text-3xl font-semibold tracking-tight text-fg">
    Technologies I use
  </h2>
  <p class="mt-3 max-w-2xl text-muted">
    Day to day I work mostly in Python and TypeScript, building agents with
    A2A, MCP and RAG, and shipping them in containers.
  </p>

  <div class="mt-10 space-y-10">
    {
      groups.map((group) => (
        <div>
          <h3 class="text-sm font-medium text-fg">{group.name}</h3>
          <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
            {group.items.map((item) => (
              <li class="group flex items-center gap-3 rounded-lg border border-line bg-surface px-4 py-3 transition-colors hover:border-muted/50">
                {item.Icon ? (
                  <item.Icon className="h-6 w-6 shrink-0 text-fg" />
                ) : (
                  <img
                    src={item.img}
                    alt=""
                    width="24"
                    height="24"
                    loading="lazy"
                    class="h-6 w-6 shrink-0 object-contain"
                  />
                )}
                <span class="text-sm text-fg">{item.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
