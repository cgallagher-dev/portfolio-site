---
import { jobs } from "../../data/jobsData";
---

<section id="experience" class="mx-auto max-w-5xl px-6 py-20">
  <p class="font-mono text-sm text-primary">Experience</p>
  <h2 class="mt-2 text-3xl font-semibold tracking-tight text-fg">
    Where I've been working
  </h2>

  <ol class="mt-10 divide-y divide-line border-y border-line">
    {
      jobs.map((job) => (
        <li class="grid gap-6 py-10 md:grid-cols-[14rem_1fr] md:gap-10">
          <div>
            <h3 class="font-medium text-fg">{job.org}</h3>
            <p class="mt-1 text-sm text-muted">{job.team}</p>
          </div>

          <div>
            <ol class="space-y-3 border-l border-line pl-5">
              {job.roles.map((role, i) => (
                <li class="relative">
                  <span
                    class:list={[
                      "absolute top-2 -left-[1.53rem] h-2 w-2 rounded-full",
                      i === 0 ? "bg-primary" : "bg-line",
                    ]}
                    aria-hidden="true"
                  />
                  <p class="text-fg">{role.title}</p>
                  <p class="font-mono text-xs text-muted">{role.time}</p>
                </li>
              ))}
            </ol>

            <ul class="mt-6 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted marker:text-line">
              {job.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>
