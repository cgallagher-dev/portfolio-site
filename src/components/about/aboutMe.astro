---
import { Image } from "astro:assets";
import headshot from "../../assets/img/headshot.png";

const interests = [
  {
    name: "Game modding",
    detail: "Working out load orders and .ini tweaks.",
  },
  {
    name: "Tabletop RPGs",
    detail: "Running and designing games, mostly for the mechanics and the balancing.",
  },
  {
    name: "Photography and video",
    detail: "Shooting on an Instax and editing in Photoshop and Premiere Pro.",
  },
];
---

<section class="mx-auto max-w-5xl px-6 py-12">
  <div class="grid items-start gap-10 md:grid-cols-[16rem_1fr]">
    <Image
      src={headshot}
      alt="Charlie Gallagher"
      width={512}
      class="aspect-[4/5] w-48 rounded-lg border border-line object-cover md:w-full"
    />

    <div class="space-y-4 text-lg leading-relaxed text-muted">
      <p>
        I'm Charlie, a final-year
        <span class="text-fg">BSc (Hons) Software Design with AI for Cloud Computing</span>
        student at the Technological University of the Shannon in Athlone.
      </p>
      <p>
        In January 2026 I joined the innovation team at
        <span class="text-fg">Hewlett Packard Enterprise</span> in Galway as an
        intern. Ten weeks in, an AI report tool I led had gone from an empty
        repo
        to production approval, and since then I've moved on to multi-agent
        systems. I'm part-time with HPE during my final year, and I start
        full-time as an Innovation Engineer (AI &amp; Cloud) in June 2027. Over
        the summer I also passed the
        <a
          href="https://www.credly.com/badges/8222cd26-aa4e-456f-85d1-f045cba5fac5/public_url"
          target="_blank"
          rel="noopener noreferrer"
          class="text-fg underline decoration-line underline-offset-4 transition-colors hover:decoration-primary"
          >AWS Certified AI Practitioner</a
        > exam.
      </p>
      <p>
        For my final-year project I'm building an open-source tool that checks
        whether small AI agents are actually safe, or just not good enough yet
        to do the harmful thing they were asked to.
      </p>
    </div>
  </div>

  <div class="mt-16">
    <h2 class="text-sm font-medium text-fg">Outside of work</h2>
    <ul class="mt-4 grid gap-3 md:grid-cols-3">
      {
        interests.map((item) => (
          <li class="rounded-lg border border-line bg-surface p-5">
            <p class="text-fg">{item.name}</p>
            <p class="mt-1 text-sm leading-relaxed text-muted">{item.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
