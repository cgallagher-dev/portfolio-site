---
import { FiMenu, FiX } from "react-icons/fi";
import SocialIcons from "../socialIcons/socialIcons.jsx";

const links = [
  { name: "Home", href: "/" },
  { name: "Projects", href: "/projects" },
  { name: "About", href: "/about" },
  { name: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "");
const isActive = (href: string) =>
  href === "/"
    ? currentPath === ""
    : currentPath === href || currentPath.startsWith(`${href}/`);
---

<div class="relative">
  <input id="menu-toggle" type="checkbox" class="peer hidden" />

  <nav
    class="fixed top-0 left-0 z-50 w-full border-b border-line bg-canvas/85 backdrop-blur"
    aria-label="Main"
  >
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
      <a href="/" class="font-medium tracking-tight text-fg">
        Charlie Gallagher
      </a>

      <div class="hidden items-center gap-8 md:flex">
        <ul class="flex items-center gap-8 text-sm">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class:list={[
                    "transition-colors hover:text-fg",
                    isActive(link.href) ? "text-fg" : "text-muted",
                  ]}
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
        <SocialIcons />
      </div>

      <label for="menu-toggle" class="cursor-pointer text-fg md:hidden">
        <span class="sr-only">Open menu</span>
        <FiMenu className="h-6 w-6" />
      </label>
    </div>
  </nav>

  <label
    for="menu-toggle"
    class="fixed inset-0 z-40 hidden cursor-pointer bg-black/60 peer-checked:block md:hidden"
  ></label>

  <div
    class="fixed top-0 right-0 z-50 h-full w-64 translate-x-full border-l border-line bg-surface transition-transform duration-300 peer-checked:translate-x-0 md:hidden"
  >
    <div class="flex justify-end p-4">
      <label for="menu-toggle" class="cursor-pointer text-fg">
        <span class="sr-only">Close menu</span>
        <FiX className="h-6 w-6" />
      </label>
    </div>

    <ul class="mt-4 flex flex-col gap-6 px-6">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "text-lg transition-colors hover:text-fg",
                isActive(link.href) ? "text-fg" : "text-muted",
              ]}
            >
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-8 px-6">
      <SocialIcons />
    </div>
  </div>
</div>
