---
export interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 pt-36 pb-4 md:pt-44">
  <h1 class="text-4xl font-semibold tracking-tight text-fg md:text-5xl">
    {title}
  </h1>
  {
    intro && (
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{intro}</p>
    )
  }
</section>
