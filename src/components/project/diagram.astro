---
interface Node {
  title: string;
  detail?: string;
}

interface Props {
  caption: string;
  steps: { label?: string; nodes: Node[] }[];
  direction?: "down" | "across";
}

const { caption, steps, direction = "down" } = Astro.props;
const across = direction === "across";

// Full class names so Tailwind can find them
const cols: Record<number, string> = {
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
};
---

<figure class="my-2">
  <ol
    class:list={[
      "flex gap-3",
      across ? "flex-col md:flex-row md:items-stretch" : "flex-col",
    ]}
  >
    {
      steps.map((step, i) => (
        <li class:list={["flex gap-3", across ? "flex-col md:flex-1 md:flex-row" : "flex-col"]}>
          <div class="flex-1 rounded-lg border border-line bg-surface p-4">
            {step.label && (
              <p class="mb-3 font-mono text-xs text-primary">{step.label}</p>
            )}
            <ul class:list={["grid gap-2", !across && cols[step.nodes.length]]}>
              {step.nodes.map((node) => (
                <li class="rounded-md border border-line bg-canvas px-3 py-2">
                  <p class="text-sm text-fg">{node.title}</p>
                  {node.detail && <p class="mt-0.5 text-xs leading-relaxed text-muted">{node.detail}</p>}
                </li>
              ))}
            </ul>
          </div>
          {i < steps.length - 1 && (
            <span
              aria-hidden="true"
              class:list={[
                "self-center font-mono text-muted",
                across ? "md:rotate-[-90deg]" : "",
              ]}
            >
              &darr;
            </span>
          )}
        </li>
      ))
    }
  </ol>
  <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>
</figure>
