---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CopyEmail from "../components/contact/copyEmail.jsx";
import headshot from "../assets/img/headshot.png";

const links = [
  {
    label: "LinkedIn",
    handle: "charliegallagher2004",
    href: "https://www.linkedin.com/in/charliegallagher2004/",
  },
  {
    label: "GitHub",
    handle: "cgallagher-dev",
    href: "https://github.com/cgallagher-dev",
  },
];
---

<Layout title="Contact" description="Get in touch with Charlie Gallagher">
  <section
    class="mx-auto grid max-w-5xl items-center gap-16 px-6 pt-36 pb-24 md:grid-cols-[1fr_auto] md:pt-44"
  >
    <div>
      <h1 class="text-4xl font-semibold tracking-tight text-fg md:text-5xl">
        Get in touch
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
        Email is the best way to reach me. I'm happy to talk about AI agents,
        evaluation, my final-year project, or anything else on this site.
      </p>

      <div class="mt-10">
        <CopyEmail client:load />
      </div>

      <ul class="mt-10 divide-y divide-line border-y border-line">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between py-4 transition-colors hover:text-primary"
              >
                <span class="text-fg">{link.label}</span>
                <span class="font-mono text-sm text-muted">
                  {link.handle} &nearr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto flex h-64 w-64 items-center justify-center">
      <Image
        src={headshot}
        alt="Charlie Gallagher"
        width={320}
        class="h-40 w-40 rounded-full border border-line object-cover object-top"
      />
      <svg
        viewBox="0 0 200 200"
        class="spin-slow absolute inset-0 h-full w-full"
        aria-hidden="true"
      >
        <path
          id="contact-ring"
          d="M100,100 m-82,0 a82,82 0 1,1 164,0 a82,82 0 1,1 -164,0"
          fill="none"></path>
        <text class="fill-muted font-mono" font-size="11" letter-spacing="2">
          <textPath href="#contact-ring">
            CHARLIE GALLAGHER · AI &amp; CLOUD · ATHLONE, IRELAND ·
          </textPath>
        </text>
      </svg>
    </div>
  </section>
</Layout>

<style>
  .spin-slow {
    animation: spin 40s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
