---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/commons/hero/hero.astro";
import ProjectCard from "../components/project/projectCard.astro";
import Banner from "../components/commons/banners/banner.astro";
import { projects } from "../data/projectData.js";

const work = projects.filter((p) => p.kind === "work");
const personal = projects.filter((p) => p.kind === "personal");
---

<Layout title="Projects" description="Projects by Charlie Gallagher">
  <Hero
    title="Projects"
    intro="Most of my recent work is internal to HPE, so those projects are written up without code or screenshots. My research and personal projects are linked where the code is public."
  />

  <section class="mx-auto max-w-5xl px-6 py-12">
    <h2 class="font-mono text-sm text-primary">Work at HPE</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {work.map((p) => <ProjectCard {...p} />)}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-12">
    <h2 class="font-mono text-sm text-primary">Research and personal</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {personal.map((p) => <ProjectCard {...p} />)}
    </div>
  </section>

  <Banner />
</Layout>
