---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="This page doesn't exist." noindex>
  <section class="mx-auto max-w-5xl px-6 pt-40 pb-32 md:pt-52">
    <p class="font-mono text-sm text-primary">404</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight text-fg md:text-5xl">
      Page not found
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
      That link doesn't go anywhere. It may have moved when I rebuilt the site.
    </p>
    <a
      href="/"
      class="mt-10 inline-block rounded-md bg-fg px-5 py-2.5 text-sm font-medium text-canvas transition-colors hover:bg-white"
    >
      Back to home
    </a>
  </section>
</Layout>
